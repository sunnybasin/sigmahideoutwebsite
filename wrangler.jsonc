{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sigmahideoutwebsite",
  "compatibility_date": "2026-09-06",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "REPLACE_WITH_YOUR_CLIENT_ID",
    "DISCORD_GUILD_ID": "REPLACE_WITH_YOUR_SERVER_ID",
    "DISCORD_ADMIN_USER_IDS": "REPLACE_WITH_COMMA_SEPARATED_USER_IDS",
    "DISCORD_PUBLIC_KEY": "REPLACE_WITH_YOUR_PUBLIC_KEY"
  },
  "r2_buckets": [
    {
      "binding": "sigma_gallery",
      "bucket_name": "sigma-gallery"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GALLERY_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
